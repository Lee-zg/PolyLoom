{
  "name": "polyloom-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "PolyLoom 多框架 UI 组件与 JavaScript 插件工作区",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm build:examples",
    "build:packages": "pnpm --filter \"./packages/**\" -r --if-present build",
    "build:examples": "pnpm --filter \"./examples/**\" -r --if-present build",
    "changeset": "changeset",
    "docs:build": "pnpm --dir apps/docs build",
    "docs:dev": "pnpm --dir apps/docs dev",
    "docs:serve": "node tooling/scripts/serve-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "node tooling/scripts/generate.mjs",
    "lint": "eslint . && stylelint \"{apps,examples,packages}/**/*.css\"",
    "release": "pnpm build:packages && changeset publish",
    "test": "vitest run --coverage",
    "test:e2e": "pnpm docs:build && playwright test",
    "test:pack": "node tooling/scripts/test-pack.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "validate:exports": "node tooling/scripts/validate-exports.mjs",
    "validate:packages": "pnpm build:packages && pnpm --filter \"./packages/**\" -r --if-present validate:package",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.11.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.4.0",
    "jsdom": "30.0.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stylelint": "^17.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-tsc": "^3.2.4"
  }
}
