{
  "name": "@polyloom/plugins",
  "version": "0.1.0",
  "description": "PolyLoom 框架无关的浏览器插件与工具",
  "keywords": [
    "polyloom",
    "typescript",
    "event-bus",
    "javascript-plugins"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lee-zg/PolyLoom.git",
    "directory": "packages/plugins"
  },
  "homepage": "https://lee-zg.github.io/PolyLoom/",
  "bugs": {
    "url": "https://github.com/Lee-zg/PolyLoom/issues"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./event-bus": {
      "types": "./dist/event-bus/index.d.ts",
      "import": "./dist/event-bus/index.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "validate:package": "node ../../tooling/scripts/validate-package.mjs"
  }
}
