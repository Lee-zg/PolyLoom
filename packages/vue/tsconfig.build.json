{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "paths": {
      "@polyloom/core": ["../core/dist/index.d.ts"],
      "@polyloom/core/*": ["../core/dist/*/index.d.ts"]
    },
    "rootDir": "src"
  },
  "exclude": ["src/**/*.test.ts"]
}
