{
  "name": "@polyloom/vue",
  "version": "0.1.0",
  "description": "PolyLoom Vue 3 UI 组件",
  "keywords": [
    "polyloom",
    "vue",
    "typescript",
    "component-library",
    "pdf-viewer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lee-zg/PolyLoom.git",
    "directory": "packages/vue"
  },
  "homepage": "https://lee-zg.github.io/PolyLoom/",
  "bugs": {
    "url": "https://github.com/Lee-zg/PolyLoom/issues"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    },
    "./button/style.css": "./dist/button/style.css",
    "./embedpdf-vue": {
      "types": "./dist/embedpdf-vue/index.d.ts",
      "import": "./dist/embedpdf-vue/index.js"
    },
    "./embedpdf-vue/style.css": "./dist/embedpdf-vue/style.css",
    "./style.css": "./dist/style.css"
  },
  "dependencies": {
    "@embedpdf/vue-pdf-viewer": "^2.14.4",
    "@polyloom/core": "workspace:^",
    "@polyloom/theme": "workspace:^"
  },
  "peerDependencies": {
    "vue": ">=3.5.0 <4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "@vue/server-renderer": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node ../../tooling/scripts/build-styles.mjs vue",
    "typecheck": "vue-tsc -p tsconfig.json",
    "validate:package": "node ../../tooling/scripts/validate-package.mjs"
  }
}
