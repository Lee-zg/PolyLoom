{
  "name": "@polyloom/theme",
  "version": "0.1.0",
  "description": "PolyLoom 设计令牌与组件样式",
  "keywords": [
    "polyloom",
    "css",
    "design-tokens",
    "theme"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lee-zg/PolyLoom.git",
    "directory": "packages/theme"
  },
  "homepage": "https://lee-zg.github.io/PolyLoom/",
  "bugs": {
    "url": "https://github.com/Lee-zg/PolyLoom/issues"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./button.css": "./dist/button.css",
    "./embedpdf-vue.css": "./dist/embedpdf-vue.css",
    "./style.css": "./dist/style.css"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../tooling/scripts/build-styles.mjs theme",
    "typecheck": "tsc -p tsconfig.json",
    "validate:package": "node ../../tooling/scripts/validate-package.mjs"
  }
}
